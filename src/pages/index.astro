---
import PageLayout from '../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import { getSite } from '../utils/consts';
import Hero from '../components/Hero.astro';

import storySetting from '../assets/story_setting.png';
import menuDessert from '../assets/menu_dessert.png';
import diningRoomInterior from '../assets/dining_room_interior.png';
import fireCookingDetail from '../assets/fire_cooking_detail.png';

const site = await getSite();
---

<PageLayout title={`${site.title} · Praha`} description={site.description}>
  <!-- Section 1: Hero Component -->
  <Hero />

  <!-- Tasting Menu CTA Section (Selected - Text Only Full-Width) -->
  <section class="reveal-on-scroll py-16 md:py-24 border-b border-[color:var(--color-border)]">
    <div class="content-shell max-w-4xl mx-auto text-center space-y-8">
      <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">SELECTION</span>
      
      <!-- Creative headline similar to hero but smaller -->
      <div class="tasting-cta-heading-wrap">
        <p class="tasting-cta-heading text-5xl sm:text-6xl lg:text-7xl font-light text-ink leading-[1.05] tracking-tight">
          <span data-lang="cz" class="block">vybráno.</span>
          <span data-lang="cz" class="block font-serif italic text-[color:var(--color-accent)]">průvodce michelin.</span>
          
          <span data-lang="en" class="block">selected.</span>
          <span data-lang="en" class="block font-serif italic text-[color:var(--color-accent)]">michelin guide.</span>
        </p>
      </div>

      <div class="text-base sm:text-lg font-light text-muted leading-relaxed space-y-4 max-w-2xl mx-auto">
        <p data-lang="cz">
          Jsme součástí výběru prestižního průvodce Michelin Guide pro Českou republiku. Děkujeme našim hostům za návštěvu a za to, že nám pomáhají růst a posouvat se kupředu.
        </p>
        <p data-lang="en">
          We are part of the Michelin Guide list for the Czech Republic. Thank you to our guests for visiting us and helping us grow and move forward.
        </p>
      </div>
      <div class="pt-4">
        <a href="#menu" class="tasting-menu-cta-link">
          <span data-lang="cz">Tasting menu ↗</span>
          <span data-lang="en">Tasting menu ↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 2: Awards & Magazine Mentions (Compact Icon Showcase) -->
  <section class="reveal-on-scroll py-10 border-b border-[color:var(--color-border)] bg-[color:var(--color-paper)]">
    <div class="content-shell max-w-5xl mx-auto">
      <!-- Icons grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 items-center justify-items-center">
        
        <!-- Michelin Real Variant -->
        <div class="flex items-center gap-3 text-ink">
          <svg viewBox="0 0 100 100" class="w-8 h-8 fill-[#E31B23]">
            <circle cx="50" cy="50" r="10" fill="#E31B23"></circle>
            <path d="M 50,22 C 55,22 55,38 50,38 C 45,38 45,22 50,22 Z" />
            <path d="M 50,62 C 55,62 55,78 50,78 C 45,78 45,62 50,62 Z" />
            <path d="M 26,36 C 28.5,31.7 42.3,39.7 39.8,44 C 37.3,48.3 23.5,40.3 26,36 Z" />
            <path d="M 60.2,56 C 62.7,51.7 76.5,59.7 74,64 C 71.5,68.3 57.7,60.3 60.2,56 Z" />
            <path d="M 74,36 C 76.5,40.3 62.7,48.3 60.2,44 C 57.7,39.7 71.5,31.7 74,36 Z" />
            <path d="M 39.8,56 C 37.3,60.3 23.5,68.3 26,64 C 28.5,59.7 42.3,51.7 39.8,56 Z" />
          </svg>
          <div class="flex flex-col text-left">
            <span class="font-sans font-black tracking-[0.08em] text-lg leading-none uppercase">MICHELIN</span>
            <span class="font-mono text-[0.55rem] tracking-[0.2em] opacity-85 mt-1">2026</span>
          </div>
        </div>
        
        <!-- Tripadvisor Real Variant -->
        <div class="flex items-center gap-3 text-ink">
          <svg viewBox="0 0 100 100" class="w-8 h-8 fill-none stroke-[2.5] stroke-ink">
            <circle cx="36" cy="50" r="16"></circle>
            <circle cx="64" cy="50" r="16"></circle>
            <circle cx="36" cy="50" r="5" fill="var(--color-ink)"></circle>
            <circle cx="64" cy="50" r="5" fill="var(--color-ink)"></circle>
            <polygon points="50,54 46,62 54,62" fill="var(--color-ink)"></polygon>
            <path d="M 12,50 C 12,70 30,82 50,82 C 70,82 88,70 88,50" stroke-linecap="round"></path>
          </svg>
          <div class="flex flex-col text-left text-[0.65rem] font-mono tracking-wider uppercase leading-tight">
            <span>Tripadvisor</span>
            <span class="opacity-75 text-[0.55rem]">Travellers' Choice</span>
          </div>
        </div>

        <!-- Gault&Millau Real Variant -->
        <div class="flex items-center gap-3 text-ink">
          <span class="font-serif font-black italic text-xl tracking-tight">Gault&amp;Millau</span>
          <div class="flex gap-1 text-sm">
            <span>🍴</span>
            <span>🍴</span>
          </div>
        </div>

        <!-- B-Corp Real Variant -->
        <div class="bcorp-badge-showcase flex items-center gap-3 scale-90">
          <span class="bcorp-top">Certified</span>
          <div class="bcorp-circle-box">
            <span>B</span>
          </div>
          <span class="bcorp-bottom">Corporation</span>
        </div>

      </div>
    </div>
  </section>

  <!-- Section 3: Narrative Section ("Chef's Notebook" - Zigzag layout) -->
  <section id="story" class="py-24 md:py-36 space-y-48 overflow-hidden">
    <!-- Notebook Entry I: Terroir (Image Left, Text Right) -->
    <div class="narrative-row reveal-on-scroll grid md:grid-cols-12 gap-12 md:gap-20 items-center">
      <div class="md:col-span-6 h-[55vh] md:h-[75vh] overflow-hidden border border-[color:var(--color-border)]">
        <Image 
          src={storySetting} 
          alt="L'Alchimiste minimal table setting" 
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
        />
      </div>
      <div class="md:col-span-6 md:col-start-7 space-y-6">
        <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">I. TERROIR</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-light leading-[1.1] text-ink font-serif">
          <span data-lang="cz">Surovina v plné nahotě.</span>
          <span data-lang="en">Raw, unhurried sourcing.</span>
        </h2>
        <div class="text-base sm:text-lg lg:text-xl font-light text-muted leading-relaxed space-y-6 max-w-xl">
          <p data-lang="cz">
            Základem každého chodu je absolutní respekt k sezónní zralosti. Spolupracujeme výhradně s malými biodynamickými farmami v Čechách a ve Francii, které sdílejí naši filozofii pomalého pěstování a úcty k půdě.
          </p>
          <p data-lang="cz">
            Naše menu se nemění podle kalendáře, ale podle ranní sklizně. Co ráno roste v zemi, večer definuje váš talíř a přináší na stůl čistou esenci přírody v její nejsyrovější a nejkrásnější podobě.
          </p>
          <p data-lang="en">
            The foundation of every course is absolute respect for seasonal maturity. We collaborate exclusively with small, biodynamic farms in Bohemia and France that share our philosophy of slow cultivation and respect for the land.
          </p>
          <p data-lang="en">
            Our menu does not adapt to the calendar, but to the morning harvest. What grows in the soil at dawn defines your plate by dusk, presenting the pure essence of nature in its rawest, most beautiful form.
          </p>
        </div>
      </div>
    </div>

    <!-- Notebook Entry II: Technique (Image Right, Text Left) -->
    <div class="narrative-row reveal-on-scroll grid md:grid-cols-12 gap-12 md:gap-20 items-center">
      <div class="md:col-span-6 space-y-6 md:order-first">
        <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">II. TECHNIQUE</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-light leading-[1.1] text-ink font-serif">
          <span data-lang="cz">Neviditelné umění.</span>
          <span data-lang="en">Invisible craftsmanship.</span>
        </h2>
        <div class="text-base sm:text-lg lg:text-xl font-light text-muted leading-relaxed space-y-6 max-w-xl">
          <p data-lang="cz">
            Složitost našich pokrmů spočívá v jejich zdánlivé jednoduchosti. Tradiční francouzské techniky redukcí a fermentace používáme k tomu, abychom zvýraznili přirozenou esenci surovin, nikoli ji zakryli.
          </p>
          <p data-lang="cz">
            Tvorba našich komplexních omáček trvá dny; dokončení na talíři pak vteřiny. Je to čistá kulinářská alchymie chutí zbavená veškerého vizuálního šumu, kde každá kapka omáčky má svůj hluboký smysl.
          </p>
          <p data-lang="en">
            The complexity of our dishes lies in their apparent simplicity. We apply classical French reduction and fermentation techniques to elevate the natural essence of the ingredients, never to mask them.
          </p>
          <p data-lang="en">
            Crafting our complex sauces takes days; plating takes seconds. It is a pure culinary alchemy stripped of all unnecessary visual noise, where every single reduction has a profound purpose.
          </p>
        </div>
      </div>
      <div class="md:col-span-6 md:order-last md:col-start-7 h-[55vh] md:h-[75vh] overflow-hidden border border-[color:var(--color-border)]">
        <Image 
          src={menuDessert} 
          alt="Michelin-starred dessert presentation" 
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
        />
      </div>
    </div>

    <!-- Notebook Entry III: Silence (Image Left, Text Right) -->
    <div class="narrative-row reveal-on-scroll grid md:grid-cols-12 gap-12 md:gap-20 items-center">
      <div class="md:col-span-6 h-[55vh] md:h-[75vh] overflow-hidden border border-[color:var(--color-border)]">
        <Image 
          src={diningRoomInterior} 
          alt="L'Alchimiste dining room interior widely spaced tables" 
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
        />
      </div>
      <div class="md:col-span-6 md:col-start-7 space-y-6">
        <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">III. SILENCE</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-light leading-[1.1] text-ink font-serif">
          <span data-lang="cz">Ticho a prostor.</span>
          <span data-lang="en">Space and serenity.</span>
        </h2>
        <div class="text-base sm:text-lg lg:text-xl font-light text-muted leading-relaxed space-y-6 max-w-xl">
          <p data-lang="cz">
            Věříme, že prostor a klid jsou pro kulinářský zážitek stejně důležité jako jídlo samotné. Naše restaurace je navržena jako útočiště pro smysly.
          </p>
          <p data-lang="cz">
            Stoly držíme ve velké vzdálenosti od sebe, abychom chránili vaše soukromí a umožnili vám plně se soustředit na vůni, texturu a chuť každého sousta bez rušivých vlivů okolí.
          </p>
          <p data-lang="en">
            We believe that space and serenity are just as crucial to a dining experience as the food itself. Our dining room is designed as a sensory sanctuary.
          </p>
          <p data-lang="en">
            We keep our tables widely spaced to protect your privacy and let your focus return completely to the aroma, texture, and flavor of each bite without any outside distractions.
          </p>
        </div>
      </div>
    </div>

    <!-- Notebook Entry IV: Fire & Water (Image Right, Text Left) -->
    <div class="narrative-row reveal-on-scroll grid md:grid-cols-12 gap-12 md:gap-20 items-center">
      <div class="md:col-span-6 space-y-6 md:order-first">
        <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">IV. FIRE & WATER</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-light leading-[1.1] text-ink font-serif">
          <span data-lang="cz">Oheň a voda.</span>
          <span data-lang="en">Fire and water.</span>
        </h2>
        <div class="text-base sm:text-lg lg:text-xl font-light text-muted leading-relaxed space-y-6 max-w-xl">
          <p data-lang="cz">
            Návrat k elementárním základům vaření. Práce s otevřeným ohněm, kouřem a dřevěným uhlím dodává našim pokrmům nezaměnitelný rustikální charakter, který se dokonale snoubí s moderní precizností.
          </p>
          <p data-lang="cz">
            Využíváme prastaré metody konzervace a zavařování, abychom uchovali plnou sílu surovin po celý rok.
          </p>
          <p data-lang="en">
            A return to the elemental foundations of cooking. Working with open fire, smoke, and charcoal infuses our dishes with a unique rustic character that pairs beautifully with modern precision.
          </p>
          <p data-lang="en">
            We utilize ancient methods of preservation and curing to capture the full strength of the seasons all year round.
          </p>
        </div>
      </div>
      <div class="md:col-span-6 md:order-last md:col-start-7 h-[55vh] md:h-[75vh] overflow-hidden border border-[color:var(--color-border)]">
        <Image 
          src={fireCookingDetail} 
          alt="Gourmet food cooking over glowing charcoal" 
          class="fire-cooking-img w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
        />
      </div>
    </div>
  </section>

  <!-- Section 4: Tasting Menu (Curated tasting menu) -->
  <section id="menu" class="reveal-on-scroll py-24 md:py-36 border-t border-b border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
    <div class="max-w-3xl mx-auto space-y-20">
      <div class="text-center space-y-4">
        <p class="text-xs uppercase tracking-[0.3em] text-muted">
          <span data-lang="cz">Lístek</span>
          <span data-lang="en">Tasting Menu</span>
        </p>
        <h2 class="text-4xl sm:text-5xl font-light text-ink">Menu Dégustation</h2>
        <p class="text-xs italic text-muted tracking-wide">
          <span data-lang="cz">Osmichodová cesta &middot; 2400 Kč</span>
          <span data-lang="en">Eight-course menu &middot; €95</span>
        </p>
      </div>

      <div class="space-y-12">
        <!-- Item 1 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light text-ink">Le Tourteau</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">380 Kč</span>
              <span data-lang="en">€15</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Krab Dungeness, řasové želé, toastový brioškový vzduch, zavařený citron Meyer.</span>
            <span data-lang="en">Dungeness crab, seaweed gelée, toasted brioche air, preserved Meyer lemon.</span>
          </p>
        </div>

        <!-- Item 2 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light text-ink">L'Asperge Blanche</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">420 Kč</span>
              <span data-lang="en">€17</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Bílý chřest z údolí Loiry, emulze z divokého česneku, lískooříškový chips, hnědé máslo.</span>
            <span data-lang="en">Loire Valley white asparagus, wild garlic emulsion, hazelnut crisp, brown butter.</span>
          </p>
        </div>

        <!-- Item 3 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light text-ink">Le Saint-Pierre</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">560 Kč</span>
              <span data-lang="en">€22</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Divoká ryba Saint-Pierre, pečený kelpový olej, mořský fenykl, redukce z měkkýšů.</span>
            <span data-lang="en">Wild John Dory, roasted kelp oil, sea fennel, shellfish reduction.</span>
          </p>
        </div>

        <!-- Item 4 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light text-ink">Le Boeuf A5</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">850 Kč</span>
              <span data-lang="en">€34</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Grilované hovězí Wagyu, popel z pórku, lanýžová šťáva, fermentované bramborové pyré.</span>
            <span data-lang="en">Seared Wagyu beef, charred leek ash, truffle jus, fermented potato purée.</span>
          </p>
        </div>

        <!-- Item 5 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light text-ink">Le Sphère de Raspberry</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">320 Kč</span>
              <span data-lang="en">€13</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Poleva z bílé čokolády, čerstvé bio maliny, růžová voda, plátkové zlato.</span>
            <span data-lang="en">White chocolate glaze, fresh organic raspberries, rosewater, edible gold leaf.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Reservations (Terracotta/wine accent link & minimal form) -->
  <section id="reservations" class="reveal-on-scroll py-24 md:py-36">
    <div class="max-w-xl mx-auto space-y-12">
      <div class="text-center space-y-4">
        <p class="text-xs uppercase tracking-[0.3em] text-muted">
          <span data-lang="cz">Rezervace stolu</span>
          <span data-lang="en">Reservations</span>
        </p>
        <h2 class="text-4xl sm:text-5xl font-light text-ink">
          <span data-lang="cz">Vstupte do salonu</span>
          <span data-lang="en">Book a Table</span>
        </h2>
        <p class="text-xs font-light text-muted leading-relaxed">
          <span data-lang="cz">Vzhledem k omezené kapacitě doporučujeme provést rezervaci s předstihem.</span>
          <span data-lang="en">Due to our intimate seating capacity, we recommend reserving several weeks in advance.</span>
        </p>
      </div>

      <form 
        class="space-y-8" 
        onsubmit="event.preventDefault(); const currentLang = document.documentElement.getAttribute('data-lang'); alert(currentLang === 'cz' ? 'Požadavek na rezervaci odeslán. Budeme vás brzy kontaktovat.' : 'Reservation Request Received. We will contact you shortly.');"
      >
        <div class="grid grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-[0.65rem] uppercase tracking-widest text-muted block">
              <span data-lang="cz">Datum</span>
              <span data-lang="en">Date</span>
            </label>
            <input 
              type="date" 
              class="w-full bg-transparent border-b border-[color:var(--color-border)] py-2 text-sm focus:outline-none focus:border-[color:var(--color-accent)] transition-colors" 
              required 
            />
          </div>
          <div class="space-y-2">
            <label class="text-[0.65rem] uppercase tracking-widest text-muted block">
              <span data-lang="cz">Hosté</span>
              <span data-lang="en">Guests</span>
            </label>
            <select 
              class="w-full bg-transparent border-b border-[color:var(--color-border)] py-2 text-sm focus:outline-none focus:border-[color:var(--color-accent)] transition-colors"
              required
            >
              <option value="1"><span data-lang="cz">1 host</span><span data-lang="en">1 Guest</span></option>
              <option value="2" selected><span data-lang="cz">2 hosté</span><span data-lang="en">2 Guests</span></option>
              <option value="3"><span data-lang="cz">3 hosté</span><span data-lang="en">3 Guests</span></option>
              <option value="4"><span data-lang="cz">4 hosté</span><span data-lang="en">4 Guests</span></option>
              <option value="5"><span data-lang="cz">5+ hostů</span><span data-lang="en">5+ Guests</span></option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-[0.65rem] uppercase tracking-widest text-muted block">
              <span data-lang="cz">Jméno</span>
              <span data-lang="en">Name</span>
            </label>
            <input 
              type="text" 
              placeholder="Your Name" 
              class="w-full bg-transparent border-b border-[color:var(--color-border)] py-2 text-sm focus:outline-none placeholder:text-muted/30 focus:border-[color:var(--color-accent)] transition-colors" 
              required 
            />
          </div>
          <div class="space-y-2">
            <label class="text-[0.65rem] uppercase tracking-widest text-muted block">
              <span data-lang="cz">E-mail</span>
              <span data-lang="en">Email</span>
            </label>
            <input 
              type="email" 
              placeholder="your@email.com" 
              class="w-full bg-transparent border-b border-[color:var(--color-border)] py-2 text-sm focus:outline-none placeholder:text-muted/30 focus:border-[color:var(--color-accent)] transition-colors" 
              required 
            />
          </div>
        </div>

        <div class="pt-6 text-center">
          <button 
            type="submit" 
            class="button-accent uppercase tracking-widest text-[0.7rem] py-4 px-12 border border-[color:var(--color-accent)] bg-[color:var(--color-accent)] text-[color:var(--color-paper)] hover:bg-transparent hover:text-[color:var(--color-accent)] transition-all duration-300 w-full sm:w-auto cursor-pointer"
          >
            <span data-lang="cz">Požádat o stůl</span>
            <span data-lang="en">Request Table</span>
          </button>
        </div>
      </form>
    </div>
  </section>
</PageLayout>

<style>


  .tasting-menu-cta-link {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 4px;
    display: inline-block;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .tasting-menu-cta-link:hover {
    color: var(--color-accent);
    transform: scale(1.05);
    font-weight: 700;
