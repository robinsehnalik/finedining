---
import PageLayout from '../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import { getSite } from '../utils/consts';
import Hero from '../components/Hero.astro';

import storySetting from '../assets/story_setting.png';
import menuDessert from '../assets/menu_dessert.png';
import diningRoomInterior from '../assets/dining_room_interior.png';
import fireCookingDetail from '../assets/fire_cooking_detail.png';



const site = await getSite();
---

<PageLayout title={`${site.title} · Praha`} description={site.description}>
  <!-- Section 1: Hero Component -->
  <Hero />

  <!-- Section 2: Awards & Magazine Mentions (Compact Icon Showcase - Moved above CTA) -->
  <section class="reveal-on-scroll py-6 border-t border-b border-[color:var(--color-border)]">
    <div class="content-shell max-w-5xl mx-auto">
      <!-- Icons grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 items-center justify-items-center">
        
        <!-- Michelin Real PNG -->
        <div class="flex items-center justify-center">
          <img src="/michelin-2025.png" alt="Michelin Guide 2025" class="h-16 md:h-20 w-auto object-contain mix-blend-multiply" />
        </div>
        
        <!-- Tripadvisor Real PNG -->
        <div class="flex items-center justify-center">
          <img src="/tripadvisor.png" alt="Tripadvisor Travellers' Choice" class="h-14 md:h-18 w-auto object-contain mix-blend-multiply" />
        </div>

        <!-- Gault&Millau Real PNG -->
        <div class="flex items-center justify-center">
          <img src="/gam.png" alt="Gault & Millau" class="h-10 md:h-12 w-auto object-contain mix-blend-multiply" />
        </div>

        <!-- B-Corp Real PNG -->
        <div class="flex items-center justify-center">
          <img src="/bcorp.png" alt="Certified B Corporation" class="h-14 md:h-18 w-auto object-contain mix-blend-multiply" />
        </div>

      </div>
    </div>
  </section>

  <!-- Tasting Menu CTA Section (Selected - Text Only Full-Width) -->
  <section class="reveal-on-scroll py-10 md:py-16 border-b border-[color:var(--color-border)]">
    <div class="content-shell max-w-4xl mx-auto text-center space-y-8">
      <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">SELECTION</span>
      
      <!-- Creative headline similar to hero but smaller - no coloring -->
      <div class="tasting-cta-heading-wrap">
        <p class="tasting-cta-heading text-5xl sm:text-6xl lg:text-7xl font-light text-ink leading-[1.05] tracking-tight">
          <span data-lang="cz" class="block font-serif">vybráno.</span>
          <span data-lang="cz" class="block font-serif italic text-ink">průvodce michelin.</span>
          
          <span data-lang="en" class="block font-serif">selected.</span>
          <span data-lang="en" class="block font-serif italic text-ink">michelin guide.</span>
        </p>
      </div>

      <div class="text-base sm:text-lg font-light text-muted leading-relaxed space-y-4 max-w-2xl mx-auto">
        <p data-lang="cz">
          Jsme součástí výběru prestižního průvodce Michelin Guide pro Českou republiku. Děkujeme našim hostům za návštěvu a za to, že nám pomáhají růst a posouvat se kupředu.
        </p>
        <p data-lang="en">
          We are part of the Michelin Guide list for the Czech Republic. Thank you to our guests for visiting us and helping us grow and move forward.
        </p>
      </div>
      <div class="pt-4">
        <a href="#menu" class="tasting-menu-cta-link">
          <span data-lang="cz">Tasting menu ↗</span>
          <span data-lang="en">Tasting menu ↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 3: Narrative Section ("Chef's Notebook" - Zigzag layout) -->
  <section id="story" class="py-24 md:py-36 space-y-48 overflow-hidden">
    <!-- Notebook Entry I: Terroir (Image Left, Text Right) -->
    <div class="narrative-row reveal-on-scroll grid md:grid-cols-12 gap-12 md:gap-20 items-center">
      <div class="md:col-span-6 h-[55vh] md:h-[75vh] overflow-hidden border border-[color:var(--color-border)]">
        <Image 
          src={storySetting} 
          alt="L'Alchimiste minimal table setting" 
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
        />
      </div>
      <div class="md:col-span-6 md:col-start-7 space-y-6">
        <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">I. TERROIR</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-light leading-[1.1] text-ink font-serif">
          <span data-lang="cz">Surovina v plné nahotě.</span>
          <span data-lang="en">Raw, unhurried sourcing.</span>
        </h2>
        <div class="text-base sm:text-lg lg:text-xl font-light text-muted leading-relaxed space-y-6 max-w-xl">
          <p data-lang="cz">
            Základem každého chodu je absolutní respekt k sezónní zralosti. Spolupracujeme výhradně s malými biodynamickými farmami v Čechách a ve Francii, které sdílejí naši filozofii pomalého pěstování a úcty k půdě.
          </p>
          <p data-lang="cz">
            Naše menu se nemění podle kalendáře, ale podle ranní sklizně. Co ráno roste v zemi, večer definuje váš talíř a přináší na stůl čistou esenci přírody v její nejsyrovější a nejkrásnější podobě.
          </p>
          <p data-lang="en">
            The foundation of every course is absolute respect for seasonal maturity. We collaborate exclusively with small, biodynamic farms in Bohemia and France that share our philosophy of slow cultivation and respect for the land.
          </p>
          <p data-lang="en">
            Our menu does not adapt to the calendar, but to the morning harvest. What grows in the soil at dawn defines your plate by dusk, presenting the pure essence of nature in its rawest, most beautiful form.
          </p>
        </div>
      </div>
    </div>

    <!-- Notebook Entry II: Technique (Image Right, Text Left) -->
    <div class="narrative-row reveal-on-scroll grid md:grid-cols-12 gap-12 md:gap-20 items-center">
      <div class="md:col-span-6 space-y-6 md:order-first">
        <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">II. TECHNIQUE</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-light leading-[1.1] text-ink font-serif">
          <span data-lang="cz">Neviditelné umění.</span>
          <span data-lang="en">Invisible craftsmanship.</span>
        </h2>
        <div class="text-base sm:text-lg lg:text-xl font-light text-muted leading-relaxed space-y-6 max-w-xl">
          <p data-lang="cz">
            Složitost našich pokrmů spočívá v jejich zdánlivé jednoduchosti. Tradiční francouzské techniky redukcí a fermentace používáme k tomu, abychom zvýraznili přirozenou esenci surovin, nikoli ji zakryli.
          </p>
          <p data-lang="cz">
            Tvorba našich komplexních omáček trvá dny; dokončení na talíři pak vteřiny. Je to čistá kulinářská alchymie chutí zbavená veškerého vizuálního šumu, kde každá kapka omáčky má svůj hluboký smysl.
          </p>
          <p data-lang="en">
            The complexity of our dishes lies in their apparent simplicity. We apply classical French reduction and fermentation techniques to elevate the natural essence of the ingredients, never to mask them.
          </p>
          <p data-lang="en">
            Crafting our complex sauces takes days; plating takes seconds. It is a pure culinary alchemy stripped of all unnecessary visual noise, where every single reduction has a profound purpose.
          </p>
        </div>
      </div>
      <div class="md:col-span-6 md:order-last md:col-start-7 h-[55vh] md:h-[75vh] overflow-hidden border border-[color:var(--color-border)]">
        <Image 
          src={menuDessert} 
          alt="Michelin-starred dessert presentation" 
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
        />
      </div>
    </div>

    <!-- Notebook Entry III: Silence (Image Left, Text Right) -->
    <div class="narrative-row reveal-on-scroll grid md:grid-cols-12 gap-12 md:gap-20 items-center">
      <div class="md:col-span-6 h-[55vh] md:h-[75vh] overflow-hidden border border-[color:var(--color-border)]">
        <Image 
          src={diningRoomInterior} 
          alt="L'Alchimiste dining room interior widely spaced tables" 
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
        />
      </div>
      <div class="md:col-span-6 md:col-start-7 space-y-6">
        <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">III. SILENCE</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-light leading-[1.1] text-ink font-serif">
          <span data-lang="cz">Ticho a prostor.</span>
          <span data-lang="en">Space and serenity.</span>
        </h2>
        <div class="text-base sm:text-lg lg:text-xl font-light text-muted leading-relaxed space-y-6 max-w-xl">
          <p data-lang="cz">
            Věříme, že prostor a klid jsou pro kulinářský zážitek stejně důležité jako jídlo samotné. Naše restaurace je navržena jako útočiště pro smysly.
          </p>
          <p data-lang="cz">
            Stoly držíme ve velké vzdálenosti od sebe, abychom chránili vaše soukromí a umožnili vám plně se soustředit na vůni, texturu a chuť každého sousta bez rušivých vlivů okolí.
          </p>
          <p data-lang="en">
            We believe that space and serenity are just as crucial to a dining experience as the food itself. Our dining room is designed as a sensory sanctuary.
          </p>
          <p data-lang="en">
            We keep our tables widely spaced to protect your privacy and let your focus return completely to the aroma, texture, and flavor of each bite without any outside distractions.
          </p>
        </div>
      </div>
    </div>

    <!-- Notebook Entry IV: Fire & Water (Image Right, Text Left) -->
    <div class="narrative-row reveal-on-scroll grid md:grid-cols-12 gap-12 md:gap-20 items-center">
      <div class="md:col-span-6 space-y-6 md:order-first">
        <span class="entry-index font-mono font-medium tracking-[0.25em] text-[color:var(--color-accent)] text-xs block">IV. FIRE & WATER</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-light leading-[1.1] text-ink font-serif">
          <span data-lang="cz">Oheň a voda.</span>
          <span data-lang="en">Fire and water.</span>
        </h2>
        <div class="text-base sm:text-lg lg:text-xl font-light text-muted leading-relaxed space-y-6 max-w-xl">
          <p data-lang="cz">
            Návrat k elementárním základům vaření. Práce s otevřeným ohněm, kouřem a dřevěným uhlím dodává našim pokrmům nezaměnitelný rustikální charakter, který se dokonale snoubí s moderní precizností.
          </p>
          <p data-lang="cz">
            Využíváme prastaré metody konzervace a zavařování, abychom uchovali plnou sílu surovin po celý rok.
          </p>
          <p data-lang="en">
            A return to the elemental foundations of cooking. Working with open fire, smoke, and charcoal infuses our dishes with a unique rustic character that pairs beautifully with modern precision.
          </p>
          <p data-lang="en">
            We utilize ancient methods of preservation and curing to capture the full strength of the seasons all year round.
          </p>
        </div>
      </div>
      <div class="md:col-span-6 md:order-last md:col-start-7 h-[55vh] md:h-[75vh] overflow-hidden border border-[color:var(--color-border)]">
        <Image 
          src={fireCookingDetail} 
          alt="Gourmet food cooking over glowing charcoal" 
          class="fire-cooking-img w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
        />
      </div>
    </div>
  </section>

</PageLayout>

<style>


  .tasting-menu-cta-link {
    font-family: var(--font-sans);
    font-size: 1.6rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2.5px solid var(--color-accent);
    padding-bottom: 8px;
    display: inline-block;
    transition: font-weight 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }

  .tasting-menu-cta-link:hover {
    font-weight: 800;
    transform: scale(1.1);
    color: var(--color-accent);
  }

  /* BCorp showcase styling */
  .bcorp-badge-showcase {
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid var(--color-border);
    padding: 10px 14px;
    background-color: var(--color-paper);
    width: fit-content;
  }

  .bcorp-badge-showcase .bcorp-top {
    font-family: var(--font-sans);
    font-size: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .bcorp-badge-showcase .bcorp-circle-box {
    width: 32px;
    height: 32px;
    border: 2px solid var(--color-ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bcorp-badge-showcase .bcorp-circle-box span {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-ink);
    line-height: 1;
    transform: translateY(1px);
  }

  .bcorp-badge-showcase .bcorp-bottom {
    font-family: var(--font-sans);
    font-size: 0.45rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    margin-top: 2px;
  }

  /* Showcase Rating Quote Lines */
  .showcase-line {
    display: block;
    width: 60px;
    height: 1.5px;
    background-color: var(--color-accent);
    margin: 0 auto;
  }

  .showcase-quote {
    font-size: 0.85rem;
    text-align: center;
  }

  /* Notebook styling */
  .entry-index {
    color: var(--color-accent);
    font-weight: 400;
  }

  .menu-item {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  /* Terracotta button */
  .button-accent {
    font-family: var(--font-sans);
    font-weight: 500;
    border-radius: 0;
  }

  /* Enhance fire cooking photo contrast and glow - Boosted to remove faded smoke look */
  .fire-cooking-img {
    filter: contrast(1.45) brightness(0.8) saturate(1.25);
  }

  input, select {
    color: var(--color-ink);
    border-radius: 0;
  }
</style>
