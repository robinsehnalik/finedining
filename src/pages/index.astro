---
import PageLayout from '../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import { getSite } from '../utils/consts';

import heroWagyu from '../assets/hero_wagyu.png';
import storySetting from '../assets/story_setting.png';
import menuDessert from '../assets/menu_dessert.png';

const site = await getSite();
---

<PageLayout title={`${site.title} · Praha`} description={site.description}>
  <!-- Section: Hero (V Zátiší custom preview layout) -->
  <section class="hero-section min-h-[90vh] grid md:grid-cols-12 items-center gap-12 py-24 md:py-36">
    <!-- Left side: Image with overlapping gold logo -->
    <div class="md:col-span-6 flex justify-center">
      <div class="hero-image-wrapper">
        <Image 
          src={heroWagyu} 
          alt="Modern gourmet plating presentation" 
          class="hero-img object-cover border border-[color:var(--color-border)]"
        />
        <!-- Overlapping large logo icon at top-right corner -->
        <div class="large-logo-overlay">
          <svg viewBox="0 0 100 100" class="logo-svg">
            <rect x="5" y="5" width="90" height="90" fill="none" stroke="var(--color-gold)" stroke-width="2.5"></rect>
            <line x1="5" y1="95" x2="95" y2="5" stroke="var(--color-gold)" stroke-width="2.5"></line>
          </svg>
        </div>
      </div>
    </div>

    <!-- Right side: Editorial monospace quote -->
    <div class="md:col-span-6 space-y-8 md:pl-6">
      <h1 class="quote-text font-light tracking-wide text-ink">
        <span data-lang="cz">
          Nový koncept, moderní interpretace lokálních chutí z farem a lesů, s příběhy krajiny a špetkou drzosti.
        </span>
        <span data-lang="en">
          A new concept, a modern interpretation of local flavors from farms and forests, with stories of the landscape and a touch of audacity.
        </span>
      </h1>
      
      <!-- Author row with gold line -->
      <div class="author-row">
        <span class="gold-line"></span>
        <span class="author-name">Marek Všelicha</span>
      </div>
    </div>
  </section>

  <!-- Section: Our Story -->
  <section id="story" class="py-24 md:py-36 border-t border-[color:var(--color-border)]">
    <div class="grid md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-5 h-[50vh] md:h-[70vh] overflow-hidden border border-[color:var(--color-border)]">
        <Image 
          src={storySetting} 
          alt="Minimalist table setting at V Zátiší" 
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
        />
      </div>
      <div class="md:col-span-6 md:col-start-7 space-y-8">
        <p class="text-xs uppercase tracking-[0.3em] text-muted">
          <span data-lang="cz">O nás</span>
          <span data-lang="en">Our Story</span>
        </p>
        <h2 class="text-4xl sm:text-5xl font-light leading-tight text-ink">
          <span data-lang="cz">Prostor pro ticho a čistou chuť.</span>
          <span data-lang="en">A space for silence and pure taste.</span>
        </h2>
        <div class="space-y-6 text-sm font-light text-muted leading-relaxed max-w-lg">
          <p data-lang="cz">
            Ve V Zátiší věříme, že prostor a klid jsou pro kulinářský zážitek stejně důležité jako jídlo samotné. Naše restaurace je navržena jako útočiště pro smysly, které vám umožní plně se soustředit na vůni, texturu a chuť každého sousta.
          </p>
          <p data-lang="cz">
            Každá surovina pochází od nezávislých lokálních farmářů z českých luhů a hájů, sbíraná za úsvitu a servírovaná na váš talíř tentýž večer.
          </p>
          <p data-lang="en">
            At V Zátiší, we believe that space and serenity are just as crucial to a dining experience as the food itself. Our dining room is designed as a sensory sanctuary, letting your focus return completely to the aroma, texture, and flavor of each bite.
          </p>
          <p data-lang="en">
            Every ingredient is sourced from independent local farms across the Czech countryside, harvested at dawn, and presented on your plate by nightfall.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: The Menu -->
  <section id="menu" class="py-24 md:py-36 border-t border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
    <div class="max-w-4xl mx-auto space-y-16">
      <div class="text-center space-y-4">
        <p class="text-xs uppercase tracking-[0.3em] text-muted">
          <span data-lang="cz">Karta</span>
          <span data-lang="en">Menu</span>
        </p>
        <h2 class="text-4xl sm:text-5xl font-light text-ink">Menu Dégustation</h2>
        <p class="text-xs italic text-muted tracking-wide">
          <span data-lang="cz">Unikátní osmichodový zážitek &middot; 2400 Kč</span>
          <span data-lang="en">A curated eight-course experience &middot; €95</span>
        </p>
      </div>

      <div class="space-y-12">
        <!-- Item 1 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light tracking-wide text-ink">Le Tourteau</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">380 Kč</span>
              <span data-lang="en">€15</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Krab Dungeness, řasové želé, toastový brioškový vzduch, zavařený citron Meyer.</span>
            <span data-lang="en">Dungeness crab, seaweed gelée, toasted brioche air, preserved Meyer lemon.</span>
          </p>
        </div>

        <!-- Item 2 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light tracking-wide text-ink">L'Asperge Blanche</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">420 Kč</span>
              <span data-lang="en">€17</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Bílý chřest z údolí Loiry, emulze z divokého česneku, lískooříškový chips, hnědé máslo.</span>
            <span data-lang="en">Loire Valley white asparagus, wild garlic emulsion, hazelnut crisp, brown butter.</span>
          </p>
        </div>

        <!-- Item 3 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light tracking-wide text-ink">Le Saint-Pierre</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">560 Kč</span>
              <span data-lang="en">€22</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Divoká ryba Saint-Pierre, pečený kelpový olej, mořský fenykl, redukce z měkkýšů.</span>
            <span data-lang="en">Wild John Dory, roasted kelp oil, sea fennel, shellfish reduction.</span>
          </p>
        </div>

        <!-- Item 4 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light tracking-wide text-ink">Le Boeuf A5</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">850 Kč</span>
              <span data-lang="en">€34</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Grilované hovězí Wagyu, popel z pórku, lanýžová šťáva, fermentované bramborové pyré.</span>
            <span data-lang="en">Seared Wagyu beef, charred leek ash, truffle jus, fermented potato purée.</span>
          </p>
        </div>

        <!-- Item 5 -->
        <div class="menu-item space-y-2">
          <div class="flex justify-between items-baseline">
            <h3 class="text-xl font-light tracking-wide text-ink">Le Sphère de Raspberry</h3>
            <span class="text-sm font-light text-muted">
              <span data-lang="cz">320 Kč</span>
              <span data-lang="en">€13</span>
            </span>
          </div>
          <p class="text-xs font-light text-muted leading-relaxed max-w-2xl">
            <span data-lang="cz">Poleva z bílé čokolády, čerstvé bio maliny, růžová voda, plátkové zlato.</span>
            <span data-lang="en">White chocolate glaze, fresh organic raspberries, rosewater, edible gold leaf.</span>
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center pt-12">
        <div class="space-y-4">
          <h4 class="text-lg font-light tracking-wide text-ink">
            <span data-lang="cz">Párování vína</span>
            <span data-lang="en">Wine Pairing</span>
          </h4>
          <p class="text-xs font-light text-muted leading-relaxed">
            <span data-lang="cz">Pečlivě vybráno naším hlavním sommelierem. Nabízíme výjimečné ročníky z historických panství i avantgardních přírodních vinařství z Burgundska a údolí Rhôny.</span>
            <span data-lang="en">Curated by our head sommelier, selecting exceptional vintages from historical estates and avant-garde natural vineyards across Burgundy and the Rhône Valley.</span>
          </p>
          <p class="text-xs italic text-muted tracking-wide">
            <span data-lang="cz">Výběr sommeliera &middot; 1400 Kč</span>
            <span data-lang="en">Sommelier Selection &middot; €55</span>
          </p>
        </div>
        <div class="h-64 overflow-hidden border border-[color:var(--color-border)]">
          <Image 
            src={menuDessert} 
            alt="Minimalist luxury dessert presentation" 
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" 
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Reservations -->
  <section id="reservations" class="py-24 md:py-36 border-t border-[color:var(--color-border)]">
    <div class="max-w-xl mx-auto space-y-12">
      <div class="text-center space-y-4">
        <p class="text-xs uppercase tracking-[0.3em] text-muted">
          <span data-lang="cz">Rezervace stolu</span>
          <span data-lang="en">Reservations</span>
        </p>
        <h2 class="text-4xl sm:text-5xl font-light text-ink">
          <span data-lang="cz">Rezervujte si stůl</span>
          <span data-lang="en">Book a Table</span>
        </h2>
        <p class="text-xs font-light text-muted leading-relaxed">
          <span data-lang="cz">Vzhledem k naší omezené kapacitě doporučujeme rezervaci čtyři týdny předem.</span>
          <span data-lang="en">Due to our intimate seating capacity, we recommend reserving four weeks in advance.</span>
        </p>
      </div>

      <form 
        class="space-y-8" 
        onsubmit="event.preventDefault(); const currentLang = document.documentElement.getAttribute('data-lang'); alert(currentLang === 'cz' ? 'Požadavek na rezervaci odeslán. Budeme vás brzy kontaktovat.' : 'Reservation Request Received. We will contact you shortly.');"
      >
        <div class="grid grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-[0.65rem] uppercase tracking-widest text-muted block">
              <span data-lang="cz">Datum</span>
              <span data-lang="en">Date</span>
            </label>
            <input 
              type="date" 
              class="w-full bg-transparent border-b border-[color:var(--color-border)] py-2 text-sm focus:outline-none focus:border-ink transition-colors" 
              required 
            />
          </div>
          <div class="space-y-2">
            <label class="text-[0.65rem] uppercase tracking-widest text-muted block">
              <span data-lang="cz">Hosté</span>
              <span data-lang="en">Guests</span>
            </label>
            <select 
              class="w-full bg-transparent border-b border-[color:var(--color-border)] py-2 text-sm focus:outline-none focus:border-ink transition-colors"
              required
            >
              <option value="1"><span data-lang="cz">1 host</span><span data-lang="en">1 Guest</span></option>
              <option value="2" selected><span data-lang="cz">2 hosté</span><span data-lang="en">2 Guests</span></option>
              <option value="3"><span data-lang="cz">3 hosté</span><span data-lang="en">3 Guests</span></option>
              <option value="4"><span data-lang="cz">4 hosté</span><span data-lang="en">4 Guests</span></option>
              <option value="5"><span data-lang="cz">5+ hostů</span><span data-lang="en">5+ Guests</span></option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-[0.65rem] uppercase tracking-widest text-muted block">
              <span data-lang="cz">Jméno</span>
              <span data-lang="en">Name</span>
            </label>
            <input 
              type="text" 
              placeholder="Your Name" 
              class="w-full bg-transparent border-b border-[color:var(--color-border)] py-2 text-sm focus:outline-none placeholder:text-muted/30 focus:border-ink transition-colors" 
              required 
            />
          </div>
          <div class="space-y-2">
            <label class="text-[0.65rem] uppercase tracking-widest text-muted block">
              <span data-lang="cz">E-mail</span>
              <span data-lang="en">Email</span>
            </label>
            <input 
              type="email" 
              placeholder="your@email.com" 
              class="w-full bg-transparent border-b border-[color:var(--color-border)] py-2 text-sm focus:outline-none placeholder:text-muted/30 focus:border-ink transition-colors" 
              required 
            />
          </div>
        </div>

        <div class="pt-4 text-center">
          <button 
            type="submit" 
            class="button primary uppercase tracking-widest text-xs py-4 px-12 border border-ink hover:bg-transparent hover:text-ink transition-colors w-full sm:w-auto"
          >
            <span data-lang="cz">Požádat o stůl</span>
            <span data-lang="en">Request Table</span>
          </button>
        </div>
      </form>
    </div>
  </section>
</PageLayout>

<style>
  .hero-section {
    padding-top: 140px;
  }

  .hero-image-wrapper {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .hero-img {
    display: block;
    width: 100%;
    max-width: 440px;
    height: auto;
    max-height: 520px;
  }

  .large-logo-overlay {
    position: absolute;
    top: 0;
    right: 0;
    transform: translate(32%, -32%);
    width: 90px;
    height: 90px;
    z-index: 10;
  }

  .logo-svg {
    width: 100%;
    height: 100%;
  }

  .quote-text {
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 1.5;
    font-weight: 300;
  }

  /* Author row with gold line */
  .author-row {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 2rem;
  }

  .gold-line {
    display: block;
    width: 40px;
    height: 1.5px;
    background-color: var(--color-gold);
  }

  .author-name {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--color-ink);
  }

  .menu-item {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  /* General typography letter spacing */
  h1, h2, h3, h4 {
    letter-spacing: 0.05em;
  }

  input, select {
    color: var(--color-ink);
    border-radius: 0;
  }
</style>
