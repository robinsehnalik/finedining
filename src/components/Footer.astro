---
import { getSite } from '../utils/consts';
const site = await getSite();
const today = new Date();
---

<footer class="border-t border-[color:var(--color-border)] py-16 text-ink">
  <div class="content-shell max-w-6xl mx-auto space-y-12">
    <!-- Top Part: Three Columns -->
    <div class="grid md:grid-cols-12 gap-12">
      <!-- Column 1: Address / contact -->
      <div class="md:col-span-4 space-y-6">
        <h3 class="footer-section-header">
          <span data-lang="cz">Adresa / kontakt</span>
          <span data-lang="en">Address / contact</span>
        </h3>
        
        <div class="text-sm font-light text-muted space-y-4 leading-relaxed">
          <p class="font-medium text-ink">{site.title} restaurant</p>
          <p>reservations@lalchimiste.cz<br/>+420 222 221 155</p>
          <p>
            Liliová 1, Praha 1,<br/>
            <span data-lang="cz">Česká republika</span>
            <span data-lang="en">Czech Republic</span><br/>
            <span class="text-xs italic" data-lang="cz">3 minuty od Karlova mostu</span>
            <span class="text-xs italic" data-lang="en">3 minutes from Charles Bridge</span>
          </p>
          <p class="text-xs">
            L'Alchimiste Catering a.s.<br/>
            Novotného lávka 5, Praha 1<br/>
            IČO: 15269574
          </p>
        </div>

        <a href="#reservations" class="footer-reserve-link">
          <span data-lang="cz">rezervace ↗</span>
          <span data-lang="en">reservation ↗</span>
        </a>
      </div>

      <!-- Column 2: Opening hours -->
      <div class="md:col-span-4 space-y-6">
        <h3 class="footer-section-header">
          <span data-lang="cz">Otevírací doba</span>
          <span data-lang="en">Opening hours</span>
        </h3>

        <div class="text-sm font-light text-muted space-y-6 leading-relaxed">
          <div class="space-y-2">
            <p class="font-medium text-ink" data-lang="cz">Pondělí — Pátek</p>
            <p class="font-medium text-ink" data-lang="en">Monday — Friday</p>
            <p>
              <span data-lang="cz">oběd 11:30–15:00</span>
              <span data-lang="en">lunch 11:30–15:00</span><br/>
              <span data-lang="cz">večeře 17:00–23:00</span>
              <span data-lang="en">dinner 17:00–23:00</span>
            </p>
          </div>

          <div class="space-y-2">
            <p class="font-medium text-ink" data-lang="cz">Sobota a Neděle</p>
            <p class="font-medium text-ink" data-lang="en">Saturday and Sunday</p>
            <p>
              <span data-lang="cz">víkendový brunch 11:30–15:00</span>
              <span data-lang="en">weekend brunch 11:30–15:00</span><br/>
              <span data-lang="cz">večeře 17:00–23:00</span>
              <span data-lang="en">dinner 17:00–23:00</span>
            </p>
          </div>
        </div>


      </div>

      <!-- Column 3: Google Map Embed -->
      <div class="md:col-span-4 space-y-6">
        <h3 class="footer-section-header">
          <span data-lang="cz">Mapa</span>
          <span data-lang="en">Map</span>
        </h3>
        
        <!-- Google Map Embed container -->
        <div class="map-container border border-[color:var(--color-border)] relative w-full h-[250px] sm:h-[280px] md:h-[300px] rounded-xl overflow-hidden">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2559.8973719818817!2d14.412175077134335!3d50.08581697152482!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470b94e107567e9d%3A0x9597be7a7bf72242!2sNovotn%C3%A9ho%20l%C3%A1vka%205%2C%20110%2000%20Star%C3%A9%20M%C4%9Bsto!5e0!3m2!1sen!2scz!4v1719769000000!5m2!1sen!2scz"
            class="absolute inset-0 w-full h-full grayscale contrast-125 opacity-90 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>

    <!-- Bottom Part: Copyright & Legal Pages -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-6 pt-12 border-t border-[color:var(--color-border)] text-muted text-xs">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-6">
        <a href="#terms" class="hover:underline">
          <span data-lang="cz">Obchodní podmínky</span>
          <span data-lang="en">Terms & Conditions</span>
        </a>
        <a href="#gdpr" class="hover:underline">
          <span data-lang="cz">GDPR / Ochrana osobních údajů</span>
          <span data-lang="en">GDPR / Privacy Policy</span>
        </a>
        <a href="#legal" class="hover:underline">
          <span data-lang="cz">Právní informace</span>
          <span data-lang="en">Legal Notice</span>
        </a>
      </div>
      <div>
        <p>&mdash; {site.title} &copy; {today.getFullYear()}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: transparent !important;
  }

  .footer-section-header {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-ink);
    border-bottom: 1.5px solid var(--color-border);
    padding-bottom: 6px;
    display: block;
    text-transform: capitalize;
  }

  .footer-reserve-link {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--color-ink);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 2px solid var(--color-accent);
    text-transform: lowercase;
    display: inline-flex;
    align-items: center;
    transition: transform 0.25s ease, font-weight 0.25s ease, border-color 0.25s ease;
  }

  .footer-reserve-link:hover {
    transform: scale(1.06);
    font-weight: 700;
  }
</style>
