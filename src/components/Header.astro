---
import { getSite } from "../utils/consts";
import { Image } from "astro:assets";
import menuDessert from "../assets/menu_dessert.png";

const site = await getSite();
const subpath = import.meta.env.BASE_URL;
---

<header class="fixed w-full z-30 flex items-center backdrop-blur-md">
  <div class="content-shell w-full py-6 md:py-8">
    <div class="flex items-center justify-between w-full">
      <!-- Left side: Unique brand text logo -->
      <a href={subpath} class="brand-text-logo" aria-label={site.title}>
        {site.title}
      </a>

      <!-- Right side: Navigation & Language switch & Popover Trigger -->
      <div class="flex items-center gap-4 md:gap-12">
        <nav class="hidden md:flex items-center gap-8 md:gap-10">
          <a href="/menu" class="nav-link-prev">
            <span data-lang="cz">menu ↗</span>
            <span data-lang="en">menu ↗</span>
          </a>
          <a href="/reservation" class="nav-link-prev">
            <span data-lang="cz">rezervace ↗</span>
            <span data-lang="en">reservation ↗</span>
          </a>
        </nav>

        <!-- Language Switcher in Header -->
        <div class="lang-switch-header lang-switch-main">
          <button class="lang-btn" data-lang-target="en">en</button>
          <span class="lang-separator">/</span>
          <button class="lang-btn" data-lang-target="cz">cz</button>
        </div>

        <!-- Hamburger Icon Box (Full Page Expandable Mobile-First Trigger) -->
        <button popovertarget="nav-menu" class="hamburger-box" aria-label="Open Menu">
          <div class="hamburger-lines">
            <span class="line"></span>
            <span class="line"></span>
            <span class="line"></span>
          </div>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Popover Full-Screen Menu Page (Covers the whole page) -->
<div id="nav-menu" popover class="menu-overlay">
  <div class="menu-overlay-container">
    <!-- Top Nav bar inside overlay to match background header layout -->
    <div class="content-shell w-full py-6 md:py-8 flex items-center justify-between border-b border-[color:var(--color-border)]">
      <a href={subpath} popovertarget="nav-menu" class="brand-text-logo" aria-label={site.title}>
        {site.title}
      </a>

      <div class="flex items-center gap-4 md:gap-12">
        <nav class="hidden md:flex items-center gap-8 md:gap-10">
          <a href="/menu" class="nav-link-prev">
            <span data-lang="cz">menu ↗</span>
            <span data-lang="en">menu ↗</span>
          </a>
          <a href="/reservation" class="nav-link-prev">
            <span data-lang="cz">rezervace ↗</span>
            <span data-lang="en">reservation ↗</span>
          </a>
        </nav>

        <div class="lang-switch-header">
          <button class="lang-btn" data-lang-target="en">en</button>
          <span class="lang-separator">/</span>
          <button class="lang-btn" data-lang-target="cz">cz</button>
        </div>

        <!-- Close Button (X icon box) -->
        <button popovertarget="nav-menu" class="close-box" aria-label="Close Menu">
          <div class="close-cross">
            <span class="cross-line line-1"></span>
            <span class="cross-line line-2"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- Main Content Area: Split Layout -->
    <div class="overlay-body grid md:grid-cols-12 gap-8 items-center py-12 px-6 max-w-6xl mx-auto w-full">
      <!-- Left Column: Branding + Food Image -->
      <div class="md:col-span-5 flex flex-col items-center md:items-start gap-8">
        <span class="brand-title-large">{site.title}</span>
        <div class="overlay-img-wrapper border border-[color:var(--color-border)]">
          <Image 
            src={menuDessert} 
            alt="Menu tasting dish" 
            class="overlay-img w-full object-cover"
          />
        </div>
      </div>

      <!-- Right Column: Navigation Links -->
      <div class="md:col-span-6 md:col-start-7 flex flex-col gap-12 text-left">
        <!-- Section 1: Menu with 5 suboptions -->
        <div class="overlay-menu-section space-y-4">
          <a href="/menu" class="overlay-section-header-link">
            <span data-lang="cz">Menu</span>
            <span data-lang="en">Menu</span>
          </a>
          <ul class="overlay-submenu-list">
            <li>
              <a href="/menu#tasting-menu" class="overlay-submenu-link">
                <span data-lang="cz">Degustační menu</span>
                <span data-lang="en">Tasting menu</span>
              </a>
            </li>
            <li>
              <a href="/menu#appetizers" class="overlay-submenu-link">
                <span data-lang="cz">Předkrmy</span>
                <span data-lang="en">Appetizers</span>
              </a>
            </li>
            <li>
              <a href="/menu#main-courses" class="overlay-submenu-link">
                <span data-lang="cz">Hlavní chody</span>
                <span data-lang="en">Main courses</span>
              </a>
            </li>
            <li>
              <a href="/menu#desserts" class="overlay-submenu-link">
                <span data-lang="cz">Dezerty</span>
                <span data-lang="en">Desserts</span>
              </a>
            </li>
            <li>
              <a href="/menu#wine-list" class="overlay-submenu-link">
                <span data-lang="cz">Vinný lístek</span>
                <span data-lang="en">Wine list</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Section 2: Reserve a Table -->
        <div class="overlay-menu-section">
          <a href="/reservation" class="overlay-section-header-link">
            <span data-lang="cz">Rezervovat stůl</span>
            <span data-lang="en">Reserve a table</span>
          </a>
        </div>

        <!-- Section 3: Groups -->
        <div class="overlay-menu-section">
          <a href="/groups" class="overlay-section-header-link">
            <span data-lang="cz">Skupiny</span>
            <span data-lang="en">Groups</span>
          </a>
        </div>

        <!-- Section 4: Mentions (awards, news) -->
        <div class="overlay-menu-section">
          <a href="/mentions" class="overlay-section-header-link">
            <span data-lang="cz">Napsali o nás &amp; ocenění</span>
            <span data-lang="en">Mentions &amp; awards</span>
          </a>
        </div>

        <!-- Overlay Footer Details -->
        <div class="overlay-menu-footer flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 pt-8 border-t border-[color:var(--color-border)]">
          <div class="space-y-1 text-xs">
            <p class="font-medium text-ink">
              <span data-lang="cz">Gourmet Club</span>
              <span data-lang="en">Gourmet Club</span>
            </p>
            <p class="text-muted">
              <span data-lang="cz">Exkluzivní kulinářské výhody</span>
              <span data-lang="en">Exclusive culinary benefits</span>
            </p>
          </div>

          <!-- Socials inside overlay -->
          <div class="flex items-center gap-5 text-ink">
            <a href="#" class="hover:text-[color:var(--color-accent)] transition-colors duration-200" aria-label="Facebook">
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.95z"/>
              </svg>
            </a>
            <a href="#" class="hover:text-[color:var(--color-accent)] transition-colors duration-200" aria-label="Instagram">
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051C.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
            <a href="#" class="hover:text-[color:var(--color-accent)] transition-colors duration-200" aria-label="YouTube">
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M23.498 6.163a3.003 3.003 0 00-2.11-2.11C19.517 3.545 12 3.545 12 3.545s-7.517 0-9.388.508a3.003 3.003 0 00-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 002.11 2.11c1.871.508 9.388.508 9.388.508s7.517 0 9.388-.508a3.003 3.003 0 002.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const STORAGE_KEY = 'vzatisi_lang';
  const DEFAULT_LANG = 'en';

  const getPreferredLang = () => {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'cz' || stored === 'en') return stored;
    return DEFAULT_LANG;
  };

  const applyLang = (lang) => {
    document.documentElement.setAttribute('data-lang', lang);
    localStorage.setItem(STORAGE_KEY, lang);
    
    // Update active class on all buttons
    document.querySelectorAll('.lang-btn').forEach(btn => {
      if (btn.getAttribute('data-lang-target') === lang) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  };

  // init lang
  const currentLang = getPreferredLang();
  applyLang(currentLang);

  // setup event listeners
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-lang-target');
      applyLang(target);
    });
  });

  // Automatically close popover when clicking a submenu link or overlay link
  document.querySelectorAll('.overlay-submenu-link, .overlay-section-header-link, .brand-text-logo, .nav-link-prev').forEach(link => {
    link.addEventListener('click', () => {
      const popover = document.getElementById('nav-menu');
      if (popover && popover.hidePopover) {
        popover.hidePopover();
      }
    });
  });
</script>

<style>
  header {
    height: 100px;
    border-bottom: 1.5px solid var(--color-border);
    background: var(--bg-header-gradient) !important;
    transition: background-color 150ms ease;
  }

  /* Unique Typographic Text Logo */
  .brand-text-logo {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.25rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: left center;
  }

  @media (min-width: 768px) {
    .brand-text-logo {
      font-size: 2.1rem;
    }
  }

  .brand-text-logo:hover {
    transform: scale(1.05);
  }

  /* Navigation Link styles - larger with bold + zoom effect on hover */
  .nav-link-prev {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--color-ink);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 2px solid var(--color-accent);
    text-transform: lowercase;
    display: inline-flex;
    align-items: center;
    transition: transform 0.25s ease, font-weight 0.25s ease, border-color 0.25s ease;
  }

  .nav-link-prev:hover {
    transform: scale(1.06);
    font-weight: 700;
  }

  /* Language Switcher in Header */
  .lang-switch-header {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--color-ink);
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .lang-switch-main {
    display: none;
  }

  @media (min-width: 768px) {
    .lang-switch-main {
      display: flex;
    }
  }

  .lang-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    color: var(--color-ink);
    opacity: 0.5;
    font-weight: 300;
    transition: transform 0.25s ease, opacity 0.25s ease, font-weight 0.25s ease;
  }

  .lang-btn:hover {
    opacity: 1;
    transform: scale(1.1);
    font-weight: 700;
  }

  .lang-btn.active {
    opacity: 1;
    font-weight: 700;
    border-bottom: 2px solid var(--color-accent);
  }

  .lang-separator {
    color: var(--color-ink);
    opacity: 0.5;
    margin: 0 4px;
  }

  /* Hamburger & Close Boxes styling without outlines */
  .hamburger-box, .close-box {
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .hamburger-box:hover, .close-box:hover {
    transform: scale(1.12);
  }

  .hamburger-box:hover .line, .close-box:hover .cross-line {
    background-color: var(--color-accent);
  }

  .hamburger-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 26px;
  }

  .hamburger-lines .line {
    height: 1.5px;
    width: 100%;
    background-color: var(--color-ink);
    transition: background-color 0.25s ease;
  }

  .close-cross {
    position: relative;
    width: 26px;
    height: 26px;
  }

  .close-cross .cross-line {
    position: absolute;
    top: 12px;
    left: 0;
    height: 1.5px;
    width: 100%;
    background-color: var(--color-ink);
    transition: background-color 0.25s ease;
  }

  .close-cross .line-1 {
    transform: rotate(45deg);
  }

  .close-cross .line-2 {
    transform: rotate(-45deg);
  }

  /* Full Screen Overlay Page overlay styling - VERY LOW TRANSPARENCY (OPAQUE) */
  .menu-overlay {
    display: none;
  }

  .menu-overlay:popover-open {
    display: flex !important;
  }

  .menu-overlay-container {
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background-color: var(--color-paper); /* Warm cream, fully opaque */
    opacity: 0.99; /* Very low transparency */
  }

  .overlay-body {
    flex: 1;
    margin-top: auto;
    margin-bottom: auto;
  }

  .brand-title-large {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.5rem;
    letter-spacing: 0.05em;
    color: var(--color-ink);
    text-transform: uppercase;
  }

  .overlay-img-wrapper {
    width: 100%;
    max-width: 320px;
  }

  .overlay-img {
    aspect-ratio: 1/1;
  }

  .overlay-section-header {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-ink);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 6px;
    display: inline-block;
    text-transform: uppercase;
  }

  .overlay-section-header-link {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-ink);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 6px;
    display: inline-block;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .overlay-section-header-link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    transform: scale(1.05);
    font-weight: 700;
  }

  .overlay-submenu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .overlay-submenu-link {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-block;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .overlay-submenu-link:hover {
    color: var(--color-accent);
    transform: scale(1.05);
    font-weight: 700;
  }
</style>
