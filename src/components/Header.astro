---
import { getSite } from "../utils/consts";
const site = await getSite();
import ThemeToggle from "./ThemeToggle.astro";
const subpath = import.meta.env.BASE_URL;
---

<header class="fixed w-full z-30 flex items-center bg-[color:var(--color-paper)]/90 backdrop-blur-md border-b border-[color:var(--color-border)]">
  <div class="content-shell w-full py-5">
    <div class="flex items-center justify-between w-full">
      <div>
        <a href={subpath} class="brand-link" aria-label={site.title}>
          <span class="brand-text">{site.title}</span>
        </a>
      </div>
      
      <nav class="hidden md:flex items-center gap-8 text-[0.72rem] tracking-[0.25em] uppercase text-muted">
        <a href="#menu" class="nav-link">The Menu</a>
        <a href="#story" class="nav-link">Our Story</a>
        <a href="#reservations" class="nav-link">Reservations</a>
      </nav>

      <div class="flex items-center gap-4">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  header {
    height: 70px;
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .nav-link {
    font-family: var(--font-sans);
    font-weight: 300;
    transition: color 150ms ease;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }
</style>
