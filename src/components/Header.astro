---
import { getSite } from "../utils/consts";
import { Image } from "astro:assets";
import menuDessert from "../assets/menu_dessert.png";

const site = await getSite();
const subpath = import.meta.env.BASE_URL;
---

<header class="fixed w-full z-30 flex items-center bg-[color:var(--color-paper)]/90 backdrop-blur-md">
  <div class="content-shell w-full py-6 md:py-8">
    <div class="flex items-center justify-between w-full">
      <!-- Left side: Unique brand text logo -->
      <a href={subpath} class="brand-text-logo" aria-label={site.title}>
        {site.title}
      </a>

      <!-- Right side: Navigation & Language switch & Popover Trigger -->
      <div class="flex items-center gap-6 md:gap-12">
        <nav class="hidden md:flex items-center gap-8 md:gap-10">
          <a href="#menu" class="nav-link-prev">
            <span data-lang="cz">menu ↗</span>
            <span data-lang="en">menu ↗</span>
          </a>
          <a href="#reservations" class="nav-link-prev">
            <span data-lang="cz">rezervace ↗</span>
            <span data-lang="en">reservation ↗</span>
          </a>
        </nav>

        <!-- Language Switcher in Header -->
        <div class="lang-switch-header">
          <button class="lang-btn" data-lang-target="en">en</button>
          <span class="lang-separator">/</span>
          <button class="lang-btn" data-lang-target="cz">cz</button>
        </div>

        <!-- Hamburger Icon Box (Full Page Expandable Mobile-First Trigger) -->
        <button popovertarget="nav-menu" class="hamburger-box" aria-label="Open Menu">
          <div class="hamburger-lines">
            <span class="line"></span>
            <span class="line"></span>
            <span class="line"></span>
          </div>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Popover Full-Screen Menu Page (Covers the whole page) -->
<div id="nav-menu" popover class="menu-overlay">
  <div class="menu-overlay-container">
    <!-- Top Nav bar inside overlay to match background header layout -->
    <div class="content-shell w-full py-6 md:py-8 flex items-center justify-between border-b border-[color:var(--color-border)]">
      <a href={subpath} popovertarget="nav-menu" class="brand-text-logo" aria-label={site.title}>
        {site.title}
      </a>

      <div class="flex items-center gap-6 md:gap-12">
        <nav class="hidden md:flex items-center gap-8 md:gap-10">
          <a href="#menu" popovertarget="nav-menu" class="nav-link-prev">
            <span data-lang="cz">menu ↗</span>
            <span data-lang="en">menu ↗</span>
          </a>
          <a href="#reservations" popovertarget="nav-menu" class="nav-link-prev">
            <span data-lang="cz">rezervace ↗</span>
            <span data-lang="en">reservation ↗</span>
          </a>
        </nav>

        <div class="lang-switch-header">
          <button class="lang-btn" data-lang-target="en">en</button>
          <span class="lang-separator">/</span>
          <button class="lang-btn" data-lang-target="cz">cz</button>
        </div>

        <!-- Close Button (X icon box) -->
        <button popovertarget="nav-menu" class="close-box" aria-label="Close Menu">
          <div class="close-cross">
            <span class="cross-line line-1"></span>
            <span class="cross-line line-2"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- Main Content Area: Split Layout -->
    <div class="overlay-body grid md:grid-cols-12 gap-8 items-center py-12 px-6 max-w-6xl mx-auto w-full">
      <!-- Left Column: Branding + Food Image -->
      <div class="md:col-span-5 flex flex-col items-center md:items-start gap-8">
        <span class="brand-title-large">{site.title}</span>
        <div class="overlay-img-wrapper border border-[color:var(--color-border)]">
          <Image 
            src={menuDessert} 
            alt="Menu tasting dish" 
            class="overlay-img w-full object-cover"
          />
        </div>
      </div>

      <!-- Right Column: Navigation Links -->
      <div class="md:col-span-6 md:col-start-7 flex flex-col gap-12 text-left">
        <!-- Section 1: Menu -->
        <div class="overlay-menu-section space-y-4">
          <h3 class="overlay-section-header">
            <span data-lang="cz">Menu</span>
            <span data-lang="en">Menu</span>
          </h3>
          <ul class="overlay-submenu-list">
            <li>
              <a href="#menu" popovertarget="nav-menu" class="overlay-submenu-link">
                <span data-lang="cz">Tasting menu</span>
                <span data-lang="en">Tasting menu</span>
              </a>
            </li>
            <li>
              <a href="#menu" popovertarget="nav-menu" class="overlay-submenu-link">
                <span data-lang="cz">Á la carte</span>
                <span data-lang="en">Á la carte</span>
              </a>
            </li>
            <li>
              <a href="#menu" popovertarget="nav-menu" class="overlay-submenu-link">
                <span data-lang="cz">Obědové menu</span>
                <span data-lang="en">Lunch menu</span>
              </a>
            </li>
            <li>
              <a href="#menu" popovertarget="nav-menu" class="overlay-submenu-link">
                <span data-lang="cz">Víkendový brunch</span>
                <span data-lang="en">Weekend brunch</span>
              </a>
            </li>
            <li>
              <a href="#menu" popovertarget="nav-menu" class="overlay-submenu-link">
                <span data-lang="cz">Vinný lístek</span>
                <span data-lang="en">Wine list</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Section 2: Group Dining -->
        <div class="overlay-menu-section">
          <a href="#menu" popovertarget="nav-menu" class="overlay-section-header-link">
            <span data-lang="cz">Skupinové akce</span>
            <span data-lang="en">Group dining</span>
          </a>
        </div>

        <!-- Section 3: About Us (Our Story) -->
        <div class="overlay-menu-section">
          <a href="#story" popovertarget="nav-menu" class="overlay-section-header-link">
            <span data-lang="cz">O nás</span>
            <span data-lang="en">Our story</span>
          </a>
        </div>

        <!-- Section 4: Contact & Reservations -->
        <div class="overlay-menu-section">
          <a href="#reservations" popovertarget="nav-menu" class="overlay-section-header-link">
            <span data-lang="cz">Rezervace &amp; Kontakt</span>
            <span data-lang="en">Reservation &amp; Contact</span>
          </a>
        </div>

        <!-- Overlay Footer Details -->
        <div class="overlay-menu-footer flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 pt-8 border-t border-[color:var(--color-border)]">
          <div class="space-y-1 text-xs">
            <p class="font-medium text-ink">
              <span data-lang="cz">Gourmet Club</span>
              <span data-lang="en">Gourmet Club</span>
            </p>
            <p class="text-muted">
              <span data-lang="cz">Exkluzivní kulinářské výhody</span>
              <span data-lang="en">Exclusive culinary benefits</span>
            </p>
          </div>

          <!-- Socials inside overlay -->
          <div class="flex items-center gap-4 text-ink text-sm">
            <a href="#" class="hover:opacity-75" aria-label="Facebook">FB</a>
            <a href="#" class="hover:opacity-75" aria-label="Instagram">IG</a>
            <a href="#" class="hover:opacity-75" aria-label="YouTube">YT</a>
            <a href="#" class="hover:opacity-75" aria-label="Tripadvisor">TA</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const STORAGE_KEY = 'vzatisi_lang';
  const DEFAULT_LANG = 'en';

  const getPreferredLang = () => {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'cz' || stored === 'en') return stored;
    return DEFAULT_LANG;
  };

  const applyLang = (lang) => {
    document.documentElement.setAttribute('data-lang', lang);
    localStorage.setItem(STORAGE_KEY, lang);
    
    // Update active class on all buttons
    document.querySelectorAll('.lang-btn').forEach(btn => {
      if (btn.getAttribute('data-lang-target') === lang) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  };

  // init lang
  const currentLang = getPreferredLang();
  applyLang(currentLang);

  // setup event listeners
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-lang-target');
      applyLang(target);
    });
  });

  // Automatically close popover when clicking a submenu link or overlay link
  document.querySelectorAll('.overlay-submenu-link, .overlay-section-header-link, .brand-text-logo, .nav-link-prev').forEach(link => {
    link.addEventListener('click', () => {
      const popover = document.getElementById('nav-menu');
      if (popover && popover.hidePopover) {
        popover.hidePopover();
      }
    });
  });
</script>

<style>
  header {
    height: 100px;
    border-bottom: 1.5px solid var(--color-border);
    transition: background-color 150ms ease;
  }

  /* Unique Typographic Text Logo */
  .brand-text-logo {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: left center;
  }

  .brand-text-logo:hover {
    transform: scale(1.05);
  }

  /* Navigation Link styles - larger with bold + zoom effect on hover */
  .nav-link-prev {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--color-ink);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 2px solid var(--color-accent);
    text-transform: lowercase;
    display: inline-flex;
    align-items: center;
    transition: transform 0.25s ease, font-weight 0.25s ease, border-color 0.25s ease;
  }

  .nav-link-prev:hover {
    transform: scale(1.06);
    font-weight: 700;
  }

  /* Language Switcher in Header */
  .lang-switch-header {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--color-ink);
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .lang-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    color: var(--color-ink);
    opacity: 0.5;
    font-weight: 300;
    transition: transform 0.25s ease, opacity 0.25s ease, font-weight 0.25s ease;
  }

  .lang-btn:hover {
    opacity: 1;
    transform: scale(1.1);
    font-weight: 700;
  }

  .lang-btn.active {
    opacity: 1;
    font-weight: 700;
    border-bottom: 2px solid var(--color-accent);
  }

  .lang-separator {
    color: var(--color-ink);
    opacity: 0.5;
    margin: 0 4px;
  }

  /* Hamburger & Close Boxes styling to match screen - with slight zoom */
  .hamburger-box, .close-box {
    width: 48px;
    height: 32px;
    background: none;
    border: 1.5px solid var(--color-ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .hamburger-box:hover, .close-box:hover {
    transform: scale(1.08);
    border-color: var(--color-accent);
  }

  .hamburger-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 26px;
  }

  .hamburger-lines .line {
    height: 1.5px;
    width: 100%;
    background-color: var(--color-ink);
  }

  .close-cross {
    position: relative;
    width: 26px;
    height: 26px;
  }

  .close-cross .cross-line {
    position: absolute;
    top: 12px;
    left: 0;
    height: 1.5px;
    width: 100%;
    background-color: var(--color-ink);
  }

  .close-cross .line-1 {
    transform: rotate(45deg);
  }

  .close-cross .line-2 {
    transform: rotate(-45deg);
  }

  /* Full Screen Overlay Page overlay styling - VERY LOW TRANSPARENCY (OPAQUE) */
  .menu-overlay {
    display: none;
  }

  .menu-overlay-container {
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background-color: var(--color-paper); /* Warm cream, fully opaque */
    opacity: 0.99; /* Very low transparency */
  }

  .overlay-body {
    flex: 1;
    margin-top: auto;
    margin-bottom: auto;
  }

  .brand-title-large {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.5rem;
    letter-spacing: 0.05em;
    color: var(--color-ink);
    text-transform: uppercase;
  }

  .overlay-img-wrapper {
    width: 100%;
    max-width: 320px;
  }

  .overlay-img {
    aspect-ratio: 1/1;
  }

  .overlay-section-header {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-ink);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 6px;
    display: inline-block;
    text-transform: uppercase;
  }

  .overlay-section-header-link {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-ink);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 6px;
    display: inline-block;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .overlay-section-header-link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    transform: scale(1.05);
    font-weight: 700;
  }

  .overlay-submenu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .overlay-submenu-link {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-block;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .overlay-submenu-link:hover {
    color: var(--color-accent);
    transform: scale(1.05);
    font-weight: 700;
  }
</style>
