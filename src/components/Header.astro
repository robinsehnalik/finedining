---
import { getSite } from "../utils/consts";
const site = await getSite();
const subpath = import.meta.env.BASE_URL;
---

<header class="fixed w-full z-30 flex items-center bg-[color:var(--color-paper)]/90 backdrop-blur-md">
  <div class="content-shell w-full py-6">
    <div class="flex items-center justify-between w-full">
      <!-- Left side: Brand Name -->
      <a href={subpath} class="logo-group" aria-label={site.title}>
        <span class="brand-title">{site.title}</span>
      </a>

      <!-- Right side: Navigation & Language switch & Hamburger -->
      <div class="flex items-center gap-8 md:gap-12">
        <nav class="flex items-center gap-6 md:gap-8">
          <a href="#menu" class="nav-link">
            <span data-lang="cz">menu ↗</span>
            <span data-lang="en">menu ↗</span>
          </a>
          <a href="#reservations" class="nav-link">
            <span data-lang="cz">rezervace ↗</span>
            <span data-lang="en">reservations ↗</span>
          </a>
        </nav>

        <!-- Language Switcher -->
        <div class="lang-switch">
          <button class="lang-btn" data-lang-target="cz">cz</button>
          <span class="lang-separator">/</span>
          <button class="lang-btn" data-lang-target="en">en</button>
        </div>

        <!-- Hamburger Icon -->
        <button class="hamburger-btn" aria-label="Toggle navigation">
          <div class="hamburger-menu">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
          </div>
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const STORAGE_KEY = 'vzatisi_lang';
  const DEFAULT_LANG = 'cz';

  const getPreferredLang = () => {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'cz' || stored === 'en') return stored;
    return DEFAULT_LANG;
  };

  const applyLang = (lang) => {
    document.documentElement.setAttribute('data-lang', lang);
    localStorage.setItem(STORAGE_KEY, lang);
    
    // Update active class on buttons
    document.querySelectorAll('.lang-btn').forEach(btn => {
      if (btn.getAttribute('data-lang-target') === lang) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  };

  // init lang
  const currentLang = getPreferredLang();
  applyLang(currentLang);

  // setup event listeners
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-lang-target');
      applyLang(target);
    });
  });
</script>

<style>
  header {
    height: 100px;
    transition: background-color 150ms ease;
  }

  .logo-group {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.4rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-ink);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1.5px solid var(--color-gold);
    display: inline-flex;
    align-items: center;
  }

  .lang-switch {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-ink);
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .lang-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    color: var(--color-ink);
    opacity: 0.6;
    font-weight: 300;
    transition: opacity 150ms ease, font-weight 150ms ease;
  }

  .lang-btn:hover {
    opacity: 1;
  }

  .lang-btn.active {
    opacity: 1;
    font-weight: 700;
    border-bottom: 1.5px solid var(--color-gold);
  }

  .lang-separator {
    color: var(--color-ink);
    opacity: 0.6;
    margin: 0 2px;
  }

  .hamburger-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .hamburger-menu {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 28px;
  }

  .hamburger-menu .bar {
    height: 1.5px;
    width: 100%;
    background-color: var(--color-ink);
  }
</style>
