---
import { Image } from "astro:assets";
import heroWagyu from "../assets/hero_wagyu.png";
---

<section class="hero-section min-h-screen flex items-center justify-center overflow-hidden relative">
  <!-- Parallax Background Image -->
  <Image 
    src={heroWagyu} 
    alt="L'Alchimiste dining atmosphere" 
    class="parallax-image w-full h-[120%] object-cover absolute top-[-10%] z-0 select-none pointer-events-none"
    loading="eager"
  />
  
  <!-- Subtle dark overlay for premium visual balance and high contrast readability -->
  <div class="absolute inset-0 bg-black/40 z-1 pointer-events-none"></div>

  <!-- Centered Content Overlay -->
  <div class="content-shell w-full flex flex-col items-center text-center space-y-10 md:space-y-12 relative z-10 text-white py-12 md:py-16">
    
    <!-- Branding Label -->
    <span class="entry-index font-mono font-medium tracking-[0.25em] text-[#C5A880] text-xs block uppercase">L'Alchimiste</span>

    <!-- Typographic Title -->
    <div class="max-w-4xl mx-auto">
      <h1 class="sr-only">L'Alchimiste - Fine Dining Restaurant Prague</h1>
      <p class="hero-heading text-5xl sm:text-7xl md:text-8xl lg:text-9xl xl:text-[8rem] font-light text-white leading-[0.95] tracking-tighter">
        pure taste. <span class="font-serif italic text-[#C5A880] block sm:inline">unhurried.</span>
      </p>
    </div>

    <!-- Chef's Quote Description -->
    <div class="max-w-2xl mx-auto space-y-4 pb-4">
      <blockquote class="hero-subtext text-lg sm:text-xl lg:text-2xl font-light text-[#EAE4D9] leading-relaxed font-serif italic">
        <span data-lang="cz">
          „Kulinářská alchymie inspirovaná klidem české krajiny a precizností francouzské kuchyně. Každý pokrm je příběh napsaný ranní sklizní.“
        </span>
        <span data-lang="en">
          “Culinary alchemy inspired by the tranquility of the Bohemian countryside and French precision. Every dish is a story written by the morning harvest.”
        </span>
      </blockquote>
      <cite class="hero-quote-author text-xs uppercase tracking-widest text-[#EAE4D9]/80 block font-sans not-italic">
        <span data-lang="cz">&mdash; šéfkuchař</span>
        <span data-lang="en">&mdash; Chef de Cuisine</span>
      </cite>
    </div>

  </div>
</section>


<style>
  .hero-section {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-top: calc(100px - var(--grid-cell)); /* Align section top exactly with bottom of header */
    min-height: calc(100vh - 100px) !important;
  }

  @media (max-width: 720px) {
    .hero-section {
      margin-top: calc(100px - (var(--grid-cell) * 4)); /* Adjust for mobile main padding-top */
    }
  }

  /* CSS-Only Hardware-Accelerated Load-in Animations (SEO & Performance Friendly) */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes imageEntry {
    from {
      opacity: 0;
      transform: scale(1.05) translateY(30px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Load-in triggers */
  .hero-heading {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 1.2s cubic-bezier(0.215, 0.61, 0.355, 1) 0.2s forwards;
  }

  .hero-subtext-container {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s cubic-bezier(0.215, 0.61, 0.355, 1) 0.5s forwards;
  }

  /* Parallax image load-in animation */
  .parallax-image {
    opacity: 0;
    animation: imageEntry 1.6s cubic-bezier(0.215, 0.61, 0.355, 1) 0.4s forwards;
  }

  /* Accessibility hide helper */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
