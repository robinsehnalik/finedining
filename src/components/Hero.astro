---
import { Image } from "astro:assets";
import heroWagyu from "../assets/hero_wagyu.png";
---

<section class="hero-section min-h-[90vh] flex items-center py-12 md:py-24 overflow-hidden">
  <div class="content-shell w-full grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-start">
    
    <!-- Left / Top Column: Typographic Content (md:col-span-7 to prevent photo overlap) -->
    <div class="md:col-span-7 space-y-8 text-left z-10">
      <!-- Hidden H1 for SEO compliance while maintaining clean design -->
      <h1 class="sr-only">L'Alchimiste - Fine Dining Restaurant Prague</h1>
      
      <div class="hero-heading-container">
        <p class="hero-heading text-7xl sm:text-8xl lg:text-9xl xl:text-[7.5rem] font-light text-ink leading-[0.95] tracking-tighter">
          <span class="block">pure taste.</span>
          <span class="block font-serif italic text-[color:var(--color-accent)]">unhurried.</span>
        </p>
      </div>

      <!-- Chef's Quote Description (Enlarged) -->
      <div class="hero-subtext-container">
        <blockquote class="hero-subtext text-lg sm:text-xl lg:text-2xl font-light text-muted leading-relaxed font-serif italic max-w-lg">
          <span data-lang="cz">
            „Kulinářská alchymie inspirovaná klidem české krajiny a precizností francouzské kuchyně. Každý pokrm je příběh napsaný ranní sklizní.“
          </span>
          <span data-lang="en">
            “Culinary alchemy inspired by the tranquility of the Bohemian countryside and French precision. Every dish is a story written by the morning harvest.”
          </span>
        </blockquote>
        <cite class="hero-quote-author text-xs uppercase tracking-widest text-ink mt-4 block font-sans not-italic">
          <span data-lang="cz">&mdash; šéfkuchař</span>
          <span data-lang="en">&mdash; Chef de Cuisine</span>
        </cite>
      </div>
    </div>

    <!-- Right / Bottom Column: Single Big 4K Image Wrapper (md:col-span-5 to prevent overlap) -->
    <div class="hero-image-wrapper md:col-span-5 relative w-full h-[50vh] sm:h-[60vh] md:h-[75vh] overflow-hidden border border-[color:var(--color-border)] md:-ml-[calc(1.5*var(--grid-cell))] md:-mr-[calc(3*var(--grid-cell))]">
      <Image 
        src={heroWagyu} 
        alt="L'Alchimiste tasting plate presentation" 
        class="parallax-image w-full h-[120%] object-cover absolute top-[-10%]"
        loading="eager"
      />
    </div>

  </div>
</section>

<style>
  /* CSS-Only Hardware-Accelerated Load-in Animations (SEO & Performance Friendly) */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes imageEntry {
    from {
      opacity: 0;
      transform: scale(1.05) translateY(30px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Load-in triggers */
  .hero-heading {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 1.2s cubic-bezier(0.215, 0.61, 0.355, 1) 0.2s forwards;
  }

  .hero-subtext-container {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s cubic-bezier(0.215, 0.61, 0.355, 1) 0.5s forwards;
  }

  /* Image wrapper animation (separates load-in animation from parallax scroll) */
  .hero-image-wrapper {
    opacity: 0;
    transform: scale(1.05) translateY(30px);
    animation: imageEntry 1.6s cubic-bezier(0.215, 0.61, 0.355, 1) 0.4s forwards;
  }

  /* Accessibility hide helper */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
